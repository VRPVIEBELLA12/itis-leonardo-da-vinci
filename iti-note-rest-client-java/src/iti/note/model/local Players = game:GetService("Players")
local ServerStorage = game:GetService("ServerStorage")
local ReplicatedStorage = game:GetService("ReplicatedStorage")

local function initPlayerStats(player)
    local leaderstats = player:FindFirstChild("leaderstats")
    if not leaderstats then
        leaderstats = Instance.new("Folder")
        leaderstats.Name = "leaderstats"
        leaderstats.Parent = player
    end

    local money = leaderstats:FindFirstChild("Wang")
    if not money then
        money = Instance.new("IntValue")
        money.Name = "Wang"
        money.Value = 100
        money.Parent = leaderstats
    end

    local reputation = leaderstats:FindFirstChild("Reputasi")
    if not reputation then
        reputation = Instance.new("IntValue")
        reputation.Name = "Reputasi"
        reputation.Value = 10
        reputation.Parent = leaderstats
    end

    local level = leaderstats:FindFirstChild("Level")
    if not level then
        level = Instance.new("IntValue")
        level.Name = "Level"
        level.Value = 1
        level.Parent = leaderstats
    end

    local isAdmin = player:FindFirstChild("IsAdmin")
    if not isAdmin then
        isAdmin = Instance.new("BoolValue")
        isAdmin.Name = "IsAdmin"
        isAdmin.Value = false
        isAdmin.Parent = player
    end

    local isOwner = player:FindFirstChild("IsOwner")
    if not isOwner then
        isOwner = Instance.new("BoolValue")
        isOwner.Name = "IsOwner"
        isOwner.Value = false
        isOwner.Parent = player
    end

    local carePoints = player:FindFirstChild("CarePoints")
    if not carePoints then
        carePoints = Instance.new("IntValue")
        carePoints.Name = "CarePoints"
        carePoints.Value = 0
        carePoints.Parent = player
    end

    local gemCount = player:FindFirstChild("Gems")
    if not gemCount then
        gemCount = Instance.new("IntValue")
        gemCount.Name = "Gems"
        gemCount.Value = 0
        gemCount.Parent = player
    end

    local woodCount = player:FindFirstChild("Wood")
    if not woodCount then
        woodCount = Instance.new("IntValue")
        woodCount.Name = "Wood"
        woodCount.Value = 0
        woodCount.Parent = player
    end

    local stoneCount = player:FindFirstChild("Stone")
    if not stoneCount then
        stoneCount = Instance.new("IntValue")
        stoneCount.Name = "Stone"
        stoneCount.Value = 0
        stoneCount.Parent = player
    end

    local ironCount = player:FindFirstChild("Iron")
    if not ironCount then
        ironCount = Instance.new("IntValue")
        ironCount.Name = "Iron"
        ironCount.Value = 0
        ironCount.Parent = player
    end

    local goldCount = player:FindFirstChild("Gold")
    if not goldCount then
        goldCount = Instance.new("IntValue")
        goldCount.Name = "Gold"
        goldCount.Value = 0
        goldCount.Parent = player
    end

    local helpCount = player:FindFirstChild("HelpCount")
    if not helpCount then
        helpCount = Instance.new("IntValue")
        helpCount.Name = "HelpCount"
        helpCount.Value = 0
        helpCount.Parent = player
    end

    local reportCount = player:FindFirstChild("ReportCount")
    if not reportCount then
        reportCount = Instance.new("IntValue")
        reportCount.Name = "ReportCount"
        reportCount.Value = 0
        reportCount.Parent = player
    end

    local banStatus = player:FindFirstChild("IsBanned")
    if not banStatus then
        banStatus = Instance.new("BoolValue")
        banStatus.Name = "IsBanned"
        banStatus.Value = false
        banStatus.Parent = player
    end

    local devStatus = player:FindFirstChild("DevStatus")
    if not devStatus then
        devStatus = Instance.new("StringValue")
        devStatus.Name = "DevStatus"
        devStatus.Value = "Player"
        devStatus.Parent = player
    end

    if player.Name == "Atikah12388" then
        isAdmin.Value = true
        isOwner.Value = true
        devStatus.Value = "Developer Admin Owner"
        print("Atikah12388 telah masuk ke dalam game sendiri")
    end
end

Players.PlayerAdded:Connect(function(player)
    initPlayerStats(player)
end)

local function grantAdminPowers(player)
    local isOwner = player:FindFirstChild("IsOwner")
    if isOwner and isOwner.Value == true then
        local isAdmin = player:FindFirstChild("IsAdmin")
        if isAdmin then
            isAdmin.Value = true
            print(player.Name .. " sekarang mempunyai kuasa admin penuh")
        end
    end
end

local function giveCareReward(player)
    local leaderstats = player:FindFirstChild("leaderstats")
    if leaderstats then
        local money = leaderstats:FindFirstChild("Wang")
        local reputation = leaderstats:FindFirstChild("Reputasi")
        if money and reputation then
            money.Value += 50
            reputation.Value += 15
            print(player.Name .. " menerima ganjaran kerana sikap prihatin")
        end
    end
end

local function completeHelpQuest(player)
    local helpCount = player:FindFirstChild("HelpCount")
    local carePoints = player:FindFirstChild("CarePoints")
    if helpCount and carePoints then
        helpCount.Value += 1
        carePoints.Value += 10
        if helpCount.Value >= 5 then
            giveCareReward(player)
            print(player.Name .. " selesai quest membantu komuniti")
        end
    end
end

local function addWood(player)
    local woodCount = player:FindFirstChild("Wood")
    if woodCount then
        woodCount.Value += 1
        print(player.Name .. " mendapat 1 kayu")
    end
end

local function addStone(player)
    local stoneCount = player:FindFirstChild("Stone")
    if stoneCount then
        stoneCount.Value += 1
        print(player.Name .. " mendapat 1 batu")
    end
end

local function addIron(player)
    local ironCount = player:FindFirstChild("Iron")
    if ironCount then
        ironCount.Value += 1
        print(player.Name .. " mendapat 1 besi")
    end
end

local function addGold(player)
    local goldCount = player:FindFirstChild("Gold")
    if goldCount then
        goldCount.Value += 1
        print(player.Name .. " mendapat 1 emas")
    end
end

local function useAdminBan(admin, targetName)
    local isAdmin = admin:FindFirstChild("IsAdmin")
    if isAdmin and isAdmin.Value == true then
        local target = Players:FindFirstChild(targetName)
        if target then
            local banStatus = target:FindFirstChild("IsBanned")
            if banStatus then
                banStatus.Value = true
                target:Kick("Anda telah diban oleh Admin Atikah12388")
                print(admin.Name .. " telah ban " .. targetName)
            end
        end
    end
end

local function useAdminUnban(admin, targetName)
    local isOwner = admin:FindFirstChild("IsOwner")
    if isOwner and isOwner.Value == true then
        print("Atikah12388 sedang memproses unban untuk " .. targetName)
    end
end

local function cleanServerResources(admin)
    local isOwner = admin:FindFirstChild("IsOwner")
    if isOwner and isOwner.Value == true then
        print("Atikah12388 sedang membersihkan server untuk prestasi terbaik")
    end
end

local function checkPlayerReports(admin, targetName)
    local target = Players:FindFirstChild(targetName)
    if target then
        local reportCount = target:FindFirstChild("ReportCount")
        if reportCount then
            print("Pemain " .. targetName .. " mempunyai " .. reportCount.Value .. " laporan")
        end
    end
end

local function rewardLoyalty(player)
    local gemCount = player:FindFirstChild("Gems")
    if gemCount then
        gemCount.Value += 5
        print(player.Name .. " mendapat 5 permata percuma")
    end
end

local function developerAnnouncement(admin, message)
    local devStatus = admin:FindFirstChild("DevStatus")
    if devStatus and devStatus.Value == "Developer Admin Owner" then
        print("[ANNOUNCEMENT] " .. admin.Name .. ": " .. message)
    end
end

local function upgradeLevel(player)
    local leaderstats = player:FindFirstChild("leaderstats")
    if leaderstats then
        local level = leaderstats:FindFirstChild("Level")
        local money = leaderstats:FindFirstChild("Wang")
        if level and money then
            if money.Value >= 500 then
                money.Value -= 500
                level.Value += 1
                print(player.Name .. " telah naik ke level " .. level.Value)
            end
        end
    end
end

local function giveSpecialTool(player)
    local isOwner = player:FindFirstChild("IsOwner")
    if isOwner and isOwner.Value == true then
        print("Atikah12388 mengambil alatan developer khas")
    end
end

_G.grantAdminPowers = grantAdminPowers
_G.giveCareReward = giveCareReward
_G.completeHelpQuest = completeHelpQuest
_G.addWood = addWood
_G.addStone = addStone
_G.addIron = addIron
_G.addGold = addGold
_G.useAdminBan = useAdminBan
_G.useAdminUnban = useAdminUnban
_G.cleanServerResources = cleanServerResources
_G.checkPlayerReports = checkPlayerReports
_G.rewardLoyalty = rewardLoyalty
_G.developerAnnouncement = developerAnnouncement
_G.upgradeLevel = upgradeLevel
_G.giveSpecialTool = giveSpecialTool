        isOwner = Instance.new("BoolValue")
        isOwner.Name = "IsOwner"
        isOwner.Value = false
        isOwner.Parent = player
    end

    local carePoints = player:FindFirstChild("CarePoints")
    if not carePoints then
        carePoints = Instance.new("IntValue")
        carePoints.Name = "CarePoints"
        carePoints.Value = 0
        carePoints.Parent = player
    end

    local gemCount = player:FindFirstChild("Gems")
    if not gemCount then
        gemCount = Instance.new("IntValue")
        gemCount.Name = "Gems"
        gemCount.Value = 0
        gemCount.Parent = player
    end

    local woodCount = player:FindFirstChild("Wood")
    if not woodCount then
        woodCount = Instance.new("IntValue")
        woodCount.Name = "Wood"
        woodCount.Value = 0
        woodCount.Parent = player
    end

    local stoneCount = player:FindFirstChild("Stone")
    if not stoneCount then
        stoneCount = Instance.new("IntValue")
        stoneCount.Name = "Stone"
        stoneCount.Value = 0
        stoneCount.Parent = player
    end

    local ironCount = player:FindFirstChild("Iron")
    if not ironCount then
        ironCount = Instance.new("IntValue")
        ironCount.Name = "Iron"
        ironCount.Value = 0
        ironCount.Parent = player
    end

    local goldCount = player:FindFirstChild("Gold")
    if not goldCount then
        goldCount = Instance.new("IntValue")
        goldCount.Name = "Gold"
        goldCount.Value = 0
        goldCount.Parent = player
    end

    local helpCount = player:FindFirstChild("HelpCount")
    if not helpCount then
        helpCount = Instance.new("IntValue")
        helpCount.Name = "HelpCount"
        helpCount.Value = 0
        helpCount.Parent = player
    end

    local reportCount = player:FindFirstChild("ReportCount")
    if not reportCount then
        reportCount = Instance.new("IntValue")
        reportCount.Name = "ReportCount"
        reportCount.Value = 0
        reportCount.Parent = player
    end

    local banStatus = player:FindFirstChild("IsBanned")
    if not banStatus then
        banStatus = Instance.new("BoolValue")
        banStatus.Name = "IsBanned"
        banStatus.Value = false
        banStatus.Parent = player
    end

    local devStatus = player:FindFirstChild("DevStatus")
    if not devStatus then
        devStatus = Instance.new("StringValue")
        devStatus.Name = "DevStatus"
        devStatus.Value = "Player"
        devStatus.Parent = player
    end

    if player.Name == "Atikah12388" then
        isAdmin.Value = true
        isOwner.Value = true
        devStatus.Value = "Developer Admin Owner"
        print("Atikah12388 telah masuk ke dalam game sendiri")
    end
end

Players.PlayerAdded:Connect(function(player)
    initPlayerStats(player)
end)

local function grantAdminPowers(player)
    local isOwner = player:FindFirstChild("IsOwner")
    if isOwner and isOwner.Value == true then
        local isAdmin = player:FindFirstChild("IsAdmin")
        if isAdmin then
            isAdmin.Value = true
            print(player.Name .. " sekarang mempunyai kuasa admin penuh")
        end
    end
end

local function giveCareReward(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local money = leaderstats:FindFirstChild("Wang")
        local reputation = leaderstats:FindFirstChild("Reputasi")
        if money and reputation then
            money.Value += 50
            reputation.Value += 15
            print(player.Name .. " menerima ganjaran kerana sikap prihatin")
        end
    end
end

local function completeHelpQuest(player)
    local helpCount = player:FindFirstChild("HelpCount")
    local carePoints = player:FindFirstChild("CarePoints")
    if helpCount and carePoints then
        helpCount.Value += 1
        carePoints.Value += 10
        if helpCount.Value >= 5 then
            giveCareReward(player)
            print(player.Name .. " selesai quest membantu komuniti")
        end
    end
end

