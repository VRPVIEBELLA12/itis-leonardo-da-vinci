    local devStatus = admin:FindFirstChild("DevStatus")
    if devStatus and devStatus.Value == "Developer Admin Owner" then
        print("[ANNOUNCEMENT] " .. admin.Name .. ": " .. message)
    end
end

local function upgradeLevel(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local level = leaderstats:FindFirstChild("Level")
        local money = leaderstats:FindFirstChild("Wang")
        if level and money then
            if money.Value >= 500 then
                money.Value -= 500
                level.Value += 1
                print(player.Name .. " telah naik ke level " .. level.Value)
            end
        end
    end
end

