local function useAdminBan(admin, targetName)
    local isAdmin = admin:FindFirstChild("IsAdmin")
    if isAdmin and isAdmin.Value == true then
        local target = Players:FindFirstChild(targetName)
        if target then
            local banStatus = target:FindFirstChild("IsBanned")
            if banStatus then
                banStatus.Value = true
                target:Kick("Anda telah diban oleh Admin Atikah12388")
                print(admin.Name .. " telah ban " .. targetName)
            end
        end
    end
end

local function useAdminUnban(admin, targetName)
