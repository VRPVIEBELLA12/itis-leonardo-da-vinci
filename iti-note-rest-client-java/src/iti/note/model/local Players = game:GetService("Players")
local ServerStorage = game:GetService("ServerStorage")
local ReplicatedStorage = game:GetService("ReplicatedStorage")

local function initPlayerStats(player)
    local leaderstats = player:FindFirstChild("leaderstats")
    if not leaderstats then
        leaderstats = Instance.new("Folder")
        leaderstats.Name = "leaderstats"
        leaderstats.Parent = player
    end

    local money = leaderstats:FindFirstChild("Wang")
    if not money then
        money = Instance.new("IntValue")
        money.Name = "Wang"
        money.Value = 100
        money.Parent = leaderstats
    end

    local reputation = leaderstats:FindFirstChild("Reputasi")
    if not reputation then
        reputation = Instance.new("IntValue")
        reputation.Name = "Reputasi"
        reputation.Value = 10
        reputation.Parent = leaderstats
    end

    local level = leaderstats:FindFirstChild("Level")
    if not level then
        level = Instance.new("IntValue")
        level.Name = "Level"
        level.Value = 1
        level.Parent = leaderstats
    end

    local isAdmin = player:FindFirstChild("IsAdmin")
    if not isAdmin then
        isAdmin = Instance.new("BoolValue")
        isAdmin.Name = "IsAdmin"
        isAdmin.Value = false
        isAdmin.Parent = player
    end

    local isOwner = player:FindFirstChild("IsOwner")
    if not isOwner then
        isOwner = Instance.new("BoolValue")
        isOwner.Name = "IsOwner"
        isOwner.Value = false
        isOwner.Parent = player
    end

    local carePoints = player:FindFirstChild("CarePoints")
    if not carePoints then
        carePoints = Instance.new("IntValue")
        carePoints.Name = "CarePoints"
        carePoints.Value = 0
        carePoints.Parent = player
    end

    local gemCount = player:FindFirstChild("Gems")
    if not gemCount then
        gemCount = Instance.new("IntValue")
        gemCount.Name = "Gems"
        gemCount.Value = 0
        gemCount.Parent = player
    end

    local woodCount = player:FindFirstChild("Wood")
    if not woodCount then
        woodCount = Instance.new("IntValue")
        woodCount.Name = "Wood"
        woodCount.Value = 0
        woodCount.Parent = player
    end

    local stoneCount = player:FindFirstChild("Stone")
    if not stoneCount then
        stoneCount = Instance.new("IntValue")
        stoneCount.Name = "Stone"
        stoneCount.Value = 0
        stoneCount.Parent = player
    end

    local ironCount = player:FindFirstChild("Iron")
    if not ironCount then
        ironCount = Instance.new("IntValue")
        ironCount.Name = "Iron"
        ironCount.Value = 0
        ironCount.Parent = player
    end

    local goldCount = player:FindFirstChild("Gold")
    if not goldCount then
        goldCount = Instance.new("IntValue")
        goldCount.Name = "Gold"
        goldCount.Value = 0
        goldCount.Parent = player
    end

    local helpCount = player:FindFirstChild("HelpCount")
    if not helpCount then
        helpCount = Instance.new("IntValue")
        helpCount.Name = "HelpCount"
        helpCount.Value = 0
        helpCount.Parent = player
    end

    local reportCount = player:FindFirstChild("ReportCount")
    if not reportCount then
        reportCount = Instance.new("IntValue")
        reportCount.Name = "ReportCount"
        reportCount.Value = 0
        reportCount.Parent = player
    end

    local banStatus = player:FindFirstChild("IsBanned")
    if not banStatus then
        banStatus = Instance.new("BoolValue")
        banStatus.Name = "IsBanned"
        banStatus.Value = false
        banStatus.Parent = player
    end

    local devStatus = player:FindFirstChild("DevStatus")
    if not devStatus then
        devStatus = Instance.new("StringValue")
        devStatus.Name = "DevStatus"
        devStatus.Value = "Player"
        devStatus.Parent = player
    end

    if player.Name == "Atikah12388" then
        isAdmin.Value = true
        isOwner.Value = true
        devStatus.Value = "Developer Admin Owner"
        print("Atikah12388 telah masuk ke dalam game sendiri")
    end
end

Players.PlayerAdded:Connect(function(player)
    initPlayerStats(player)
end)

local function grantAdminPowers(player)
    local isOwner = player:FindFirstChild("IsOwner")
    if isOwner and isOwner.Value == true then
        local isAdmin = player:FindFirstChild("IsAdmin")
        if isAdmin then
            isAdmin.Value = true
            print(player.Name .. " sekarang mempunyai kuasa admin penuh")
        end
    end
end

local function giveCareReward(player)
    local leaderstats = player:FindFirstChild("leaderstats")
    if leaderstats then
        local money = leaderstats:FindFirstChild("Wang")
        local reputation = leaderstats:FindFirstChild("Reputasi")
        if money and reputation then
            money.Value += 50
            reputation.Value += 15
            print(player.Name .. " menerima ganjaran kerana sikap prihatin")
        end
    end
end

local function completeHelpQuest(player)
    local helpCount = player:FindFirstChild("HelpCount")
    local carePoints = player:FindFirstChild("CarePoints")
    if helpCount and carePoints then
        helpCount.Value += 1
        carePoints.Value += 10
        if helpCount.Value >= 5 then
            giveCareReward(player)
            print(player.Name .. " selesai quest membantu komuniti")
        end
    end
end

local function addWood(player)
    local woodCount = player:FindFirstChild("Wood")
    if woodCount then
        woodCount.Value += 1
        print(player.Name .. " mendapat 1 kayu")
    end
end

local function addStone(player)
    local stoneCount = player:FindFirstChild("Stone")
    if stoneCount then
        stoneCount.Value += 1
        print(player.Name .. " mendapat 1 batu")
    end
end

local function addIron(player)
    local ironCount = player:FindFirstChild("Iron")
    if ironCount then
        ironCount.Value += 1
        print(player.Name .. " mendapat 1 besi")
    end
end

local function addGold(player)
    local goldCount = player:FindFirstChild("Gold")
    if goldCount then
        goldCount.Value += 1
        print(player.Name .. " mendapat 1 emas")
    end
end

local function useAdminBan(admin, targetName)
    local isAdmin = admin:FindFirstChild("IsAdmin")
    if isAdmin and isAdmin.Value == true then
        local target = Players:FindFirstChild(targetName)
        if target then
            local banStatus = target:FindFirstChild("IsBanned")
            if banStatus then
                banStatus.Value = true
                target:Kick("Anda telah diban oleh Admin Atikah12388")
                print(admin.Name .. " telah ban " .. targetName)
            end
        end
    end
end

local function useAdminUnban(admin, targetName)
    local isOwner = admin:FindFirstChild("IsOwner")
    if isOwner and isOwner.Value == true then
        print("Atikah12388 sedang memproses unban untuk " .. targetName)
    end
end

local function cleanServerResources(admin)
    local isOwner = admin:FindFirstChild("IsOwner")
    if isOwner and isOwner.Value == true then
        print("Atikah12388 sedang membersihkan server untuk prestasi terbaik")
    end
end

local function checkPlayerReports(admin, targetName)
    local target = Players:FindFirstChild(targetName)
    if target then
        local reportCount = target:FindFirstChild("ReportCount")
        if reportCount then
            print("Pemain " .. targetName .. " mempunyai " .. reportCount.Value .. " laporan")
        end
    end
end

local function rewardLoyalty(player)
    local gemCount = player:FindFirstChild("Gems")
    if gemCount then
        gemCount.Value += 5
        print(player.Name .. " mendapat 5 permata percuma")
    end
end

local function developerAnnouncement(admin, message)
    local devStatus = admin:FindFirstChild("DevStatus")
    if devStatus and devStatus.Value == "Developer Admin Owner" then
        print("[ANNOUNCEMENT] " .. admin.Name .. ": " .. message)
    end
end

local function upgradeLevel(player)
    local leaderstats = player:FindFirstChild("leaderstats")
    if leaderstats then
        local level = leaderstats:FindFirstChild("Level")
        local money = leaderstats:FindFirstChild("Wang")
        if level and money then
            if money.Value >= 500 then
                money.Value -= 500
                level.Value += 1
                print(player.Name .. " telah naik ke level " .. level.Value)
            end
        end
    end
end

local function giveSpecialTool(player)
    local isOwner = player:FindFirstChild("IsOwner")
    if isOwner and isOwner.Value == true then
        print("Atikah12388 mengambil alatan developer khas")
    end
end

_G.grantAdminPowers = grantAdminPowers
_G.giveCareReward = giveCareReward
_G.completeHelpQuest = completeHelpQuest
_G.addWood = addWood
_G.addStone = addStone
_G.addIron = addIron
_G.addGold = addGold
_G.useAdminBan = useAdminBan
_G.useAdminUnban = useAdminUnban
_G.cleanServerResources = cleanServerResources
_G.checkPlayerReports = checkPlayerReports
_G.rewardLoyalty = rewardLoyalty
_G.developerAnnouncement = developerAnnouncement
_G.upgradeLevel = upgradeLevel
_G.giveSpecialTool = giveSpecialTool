local function initPlayerStats(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
    end

    local money = leaderstats:FindFirstChild("Wang")
    if not money then
        money = Instance.new("IntValue")
        money.Name = "Wang"
        money.Value = 100
        money.Parent = leaderstats
    end

    local reputation = leaderstats:FindFirstChild("Reputasi")
    if not reputation then
        reputation = Instance.new("IntValue")
        reputation.Name = "Reputasi"
        reputation.Value = 10
        reputation.Parent = leaderstats
    end

    local level = leaderstats:FindFirstChild("Level")
    if not level then
        level = Instance.new("IntValue")
        level.Name = "Level"
        level.Value = 1
        level.Parent = leaderstats
    end

    local isAdmin = player:FindFirstChild("IsAdmin")
    if not isAdmin then
        isAdmin = Instance.new("BoolValue")
        isAdmin.Name = "IsAdmin"
        isAdmin.Value = false
        isAdmin.Parent = player
    end

    local isOwner = player:FindFirstChild("IsOwner")
